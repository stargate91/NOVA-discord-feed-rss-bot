{
  "ignoreFiles": [
    "src/app/globals.css",
    "src/app/ui.css",
    "src/styles/reset.css",
    ".next/**",
    "node_modules/**"
  ],
  "rules": {
    "color-named": "never",
    "unit-disallowed-list": [
      ["px"],
      {
        "ignoreProperties": {
          "px": ["border", "border-width", "border-top", "border-right", "border-bottom", "border-left", "box-shadow"]
        }
      }
    ],
    "function-disallowed-list": ["rgb", "rgba"],
    "declaration-property-value-disallowed-list": {
      "/^(?!--).*(?:color|background|border|outline|box-shadow|text-shadow)/": [
        "/#[0-9a-fA-F]{3,8}/",
        "/rgba?\\(/"
      ],
      "/^(?!--).*(?:padding|margin|gap)/": ["/\\d+px/"],
      "/^(?!--).*(?:border-radius)/": ["/\\d+px/"],
      "/^(?!--).*(?:font-size)/": ["/\\d+px/"],
      "/^(?!--).*(?:font-weight)/": ["/^[0-9]+$/"],
      "/^(?!--).*(?:z-index)/": ["/^-?[0-9]+$/"],
      "/^(?!--).*(?:transition|animation)/": [
        "/\\b\\d+(?:\\.\\d+)?m?s\\b/",
        "/cubic-bezier/",
        "/(?<![\\w-])(?:ease|ease-in|ease-out|ease-in-out|linear)(?![\\w-])/"
      ]
    },
    "declaration-no-important": true,
    "max-nesting-depth": 3,
    "no-duplicate-selectors": true,
    "value-keyword-case": "lower",
    "property-no-vendor-prefix": true,
    "value-no-vendor-prefix": true,
    "color-function-notation": "modern",
    "selector-class-pattern": "^[a-z0-9]+(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
    "declaration-block-no-duplicate-properties": true,
    "shorthand-property-no-redundant-values": true,
    "no-descending-specificity": true,
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "font-family-no-missing-generic-family-keyword": true,
    "keyframe-declaration-no-important": true,
    "custom-property-pattern": "^([a-z0-9]+-)*[a-z0-9]+$"
  },
  "overrides": [
    {
      "files": ["src/styles/**/*.css"],
      "rules": {
        "color-function-notation": null,
        "function-disallowed-list": null,
        "unit-disallowed-list": null,
        "declaration-property-value-disallowed-list": null,
        "value-keyword-case": null
      }
    }
  ]
}
