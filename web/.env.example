# ==============================================================================
# Nova Feeds Web Application — Environment Configuration Template
# Copy this file to `.env` or `.env.local` to override default settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Backend Microservice Connectivity
# ------------------------------------------------------------------------------
# FastAPI Backend endpoint (proxied automatically in Vite dev mode to avoid CORS)
VITE_API_URL=http://localhost:8080

# Public Production Application URL (used for SEO canonical tags, sitemaps & OAuth redirects)
VITE_APP_URL=https://novafeeds.xyz

# ------------------------------------------------------------------------------
# 2. Discord Application & OAuth2 Configuration
# ------------------------------------------------------------------------------
# Discord Developer Application Client ID (from Discord Developer Portal)
VITE_DISCORD_CLIENT_ID=1489908793780338688

# Bot Permissions integer bitmask (Send Messages, Embed Links, Attach Files, Manage Webhooks, etc.)
VITE_DISCORD_BOT_PERMISSIONS=277025508352

# Set to 'true' to force offline demo mock authentication without hitting real Discord OAuth2
VITE_MOCK_AUTH=false

# ------------------------------------------------------------------------------
# 3. Telemetry & Error Reporting (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for client-side exception and crash tracking
VITE_SENTRY_DSN=

# Custom HTTP telemetry/error webhook ingest URL (Datadog, Grafana Faro, or custom collector)
VITE_ERROR_REPORTING_ENDPOINT=
