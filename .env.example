# ==========================================
# Nova Discord Feed Bot - Environment Config
# ==========================================

# 1. Discord Bot Gateway Credentials
BOT_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=!

# 2. Database Connection (PostgreSQL asyncpg / SQLAlchemy)
DATABASE_URL=postgresql://user:password@localhost:5432/feed_bot

# 3. Redis Queue (Optional for multi-worker distributed architecture)
REDIS_URL=redis://localhost:6379/0

# 4. Internal API & Webhook Server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_secure_internal_rpc_secret_key_here
CORS_ORIGINS=*

# 5. External Aggregators & Telemetry (Optional)
ENVIRONMENT=production
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
DB_SLOW_QUERY_MS=100.0

# 6. Stripe Payment & Billing Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TIER1_MO=price_...
STRIPE_PRICE_TIER2_MO=price_...
STRIPE_PRICE_TIER3_MO=price_...

# 7. Third-Party Provider APIs & Token Credentials
YOUTUBE_API_KEY=your_google_youtube_api_key
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
GITHUB_TOKEN=your_github_personal_access_token
STEAM_API_KEY=your_steam_web_api_key
TMDB_API_KEY=your_tmdb_api_key
TMDB_BEARER_TOKEN=your_tmdb_bearer_token
